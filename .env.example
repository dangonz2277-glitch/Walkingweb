# Ejemplo de configuración para WalkingWeb
# Nunca pongas contraseñas reales en este archivo.

# Contraseña maestra del sitio (requerida)
SITE_PASSWORD="pon_aqui_una_contrasena_segura"

# Secreto para firmar la cookie de sesión del proxy (requerida, mínimo 32 caracteres)
SITE_SESSION_SECRET="pon_aqui_un_secreto_largo_y_aleatorio_para_firmar"

# ===== Configuración de Supabase (Producción / Nuevas Claves) =====

# URL y Clave Pública de Supabase (requerido para cliente web)
NEXT_PUBLIC_SUPABASE_URL="https://tu_proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="tu_clave_publica_publishable"

# URL, Claves y JWKS de Supabase (requerido para servidor y tests)
SUPABASE_URL="https://tu_proyecto.supabase.co"
SUPABASE_PUBLISHABLE_KEY="tu_clave_publica_publishable"
SUPABASE_SECRET_KEY="tu_clave_secreta_secret"
SUPABASE_JWKS_URL="https://tu_proyecto.supabase.co/rest/v1/rpc/get_jwks"

# ===== Compatibilidad Legacy (Solo Local / Test) =====
# NOTA: En producción, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY y SUPABASE_SECRET_KEY son obligatorias.
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu_clave_legacy_anon_jwt"
SUPABASE_SERVICE_ROLE_KEY="tu_clave_legacy_service_role_jwt"
